{
  "version": "acceptance-v2",
  "rubric": "v3 (policy over the unchanged question file)",
  "calibrated": false,
  "note": "User decisions of 2026-10-14: feature-presence questions do not count against acceptance; spacing and color/depth use measured checks and theme colors instead of Clef. design-eval.ts stays byte-identical.",
  "screenPass": {
    "minScore": 0.8,
    "blockers": "empty",
    "weakDimensions": "empty",
    "verdictNot": "review",
    "minAnswer": 0.4,
    "allAreasPass": true
  },
  "denoise": {
    "replicates": 4,
    "jpegQualities": [null, 95, 90, 85],
    "noiseFloor": 0.03,
    "dropRule": "A dimension drops only when after - before < -max(noiseFloor, 2 * sqrt(sdBefore^2 + sdAfter^2)), with sd taken across replicates."
  },
  "keyboardActions": {
    "prefix": "Pressed ",
    "questions": ["feedback_focus_visible", "feedback_layout_shift"],
    "reason": "states_feedback and feedback_selected judge a pressed control; for a key press the feedback is the focus mark."
  },
  "areas": {
    "layout": {
      "gate": "clef+measured",
      "measured": ["headerOneRow"],
      "questions": [
        "focus_primary_path",
        "focus_content_share",
        "focus_reading_order",
        "overflow_long_text",
        "type_hierarchy",
        "type_scale",
        "type_line_height",
        "type_numbers",
        "type_mono",
        "slop_eyebrow_label",
        "slop_icon_tile_heading",
        "slop_badge_headline",
        "slop_italic_serif_headline",
        "slop_hero_headline",
        "slop_flat_hierarchy",
        "slop_tight_tracking",
        "slop_numbered_labels",
        "slop_hero_metric",
        "slop_card_grid",
        "slop_nested_cards",
        "slop_hidden_image",
        "quality_tiny_text",
        "quality_all_caps",
        "quality_long_lines",
        "quality_text_covered",
        "quality_overflow",
        "quality_broken_image",
        "quality_scroll_edge"
      ]
    },
    "spacing": {
      "gate": "measured",
      "measured": ["specRowHeights", "footerLeftAligned", "spacingOnScale", "chatBarInset", "targetSize24px"],
      "questions": ["slop_monotonous_spacing", "quality_cramped", "quality_heading_spacing"]
    },
    "color-depth": {
      "gate": "measured",
      "measured": ["textContrastAA", "nonTextContrast3"],
      "questions": [
        "restraint_noise",
        "icons_one_set",
        "icons_size",
        "icons_meaning",
        "slop_grid_background",
        "slop_rounded_border_accent",
        "slop_side_stripe",
        "slop_border_and_shadow",
        "slop_glass",
        "slop_stripes",
        "slop_extreme_radius",
        "slop_rough_illustration",
        "slop_placeholder_illustration",
        "slop_glow",
        "slop_ai_palette",
        "slop_dark_glow",
        "slop_gradient_text",
        "quality_gray_on_color"
