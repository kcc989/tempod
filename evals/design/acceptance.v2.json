  "measuredToScorerChecks": {
    "textContrastAA": "textContrastAA",
    "nonTextContrast3": "nonTextContrast3",
    "targetSize24px": "targetSize24px",
    "spacingOnScale": "spacingOnScale",
    "matchesDesignSystem": ["specRowHeights", "footerLeftAligned", "chatBarInset"],
    "noHorizontalOverflow": "headerOneRow"
