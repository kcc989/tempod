    "usability": {
      "gate": "clef",
      "measured": [],
      "questions": [
        "focus_affordance",
        "status_items",
        "status_async",
        "status_attention",
        "status_consistent",
        "status_lifecycle",
        "ai_steps",
        "ai_marked",
        "control_ask",
        "control_diff",
        "control_consent",
        "scan_rows",
        "scan_missing",
        "scan_overflow",
        "nav_current",
        "nav_groups",
        "nav_return",
        "nav_tabs_current",
        "speed_search",
        "states_empty",
        "states_errors",
        "states_disabled_clear",
        "copy_labels",
