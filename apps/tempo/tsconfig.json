{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["./worker-runtime.d.ts", "vite/client", "@cloudflare/vitest-plugin/types"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "cloudflare.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-runtime.d.ts",
    "vitest.components.config.ts",
    "vite.web-test.config.ts",
    "vitest.worker.config.ts",
    "vitest.ui.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
