{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["TEMPO_IMAGE_TEST"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@tempo/tempod#build": {
      "env": ["TEMPO_BUILD_ID"],
      "outputs": ["$TURBO_ROOT$/dist/tempod"]
    },
    "@tempo/e2e#test": {
      "cache": false
    },
    "@tempo/conformance#test": {
      "cache": false
    },
    "@tempo/tempod#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["TEMPO_IMAGE_TEST"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/container/pi/**"]
    }
  },
  "globalDependencies": ["tsconfig*.json", "bunfig.toml", "patches/**"],
  "globalPassThroughEnv": ["XDG_CONFIG_HOME", "XDG_CACHE_HOME", "WRANGLER_SEND_METRICS"]
}
