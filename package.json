{
  "name": "tempo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@tempo/app",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test && bun test scripts/*.test.ts",
    "test:conformance": "bun run --cwd tests/conformance test",
    "test:e2e": "bun run --cwd tests/e2e test",
    "check:versions": "bun container/check-versions.ts",
    "deploy": "bun scripts/deploy.ts",
    "build:tempod": "turbo run build --filter=@tempo/tempod",
    "protocol:gen": "bun packages/protocol/scripts/gen-schema.ts",
    "protocol:fixtures": "bun packages/protocol/scripts/gen-fixtures.ts",
    "mac:dev": "cargo run -p tempo-mac",
    "mac:test": "cargo test --workspace",
    "mac:release": "bash scripts/mac/release.sh",
    "test:tempod:container": "bun scripts/test-tempod-container.ts",
    "test:web": "bun run --cwd tests/e2e test:web"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "alchemy@2.0.0-beta.81": "patches/alchemy@2.0.0-beta.81.patch"
  }
}
