{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversationArtifact",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [1]
    },
    "conversationId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "$ref": "AgentId.json"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "SessionStatus.json"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "closedAt": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": ["Infinity", "-Infinity", "NaN"]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "agent", "title", "status", "createdAt", "closedAt"],
        "additionalProperties": true
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "Turn.json"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "Item.json"
      }
    }
  },
  "required": [
    "version",
    "conversationId",
    "projectId",
    "title",
    "branch",
    "updatedAt",
    "sessions",
    "turns",
    "items"
  ],
  "additionalProperties": true
}
