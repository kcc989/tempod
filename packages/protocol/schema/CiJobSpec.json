{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CiJobSpec",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutMinutes": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["key", "name", "needs", "timeoutMinutes"],
  "additionalProperties": true
}
