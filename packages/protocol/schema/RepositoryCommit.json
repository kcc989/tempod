{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryCommit",
  "type": "object",
  "properties": {
    "hash": {
      "type": "string"
    },
    "treeHash": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": ["name", "email"],
      "additionalProperties": true
    },
    "committer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": ["name", "email"],
      "additionalProperties": true
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authoredAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "committedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["hash", "treeHash", "message", "author", "committer", "parents", "authoredAt", "committedAt"],
  "additionalProperties": true
}
