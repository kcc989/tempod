{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoleResult",
  "type": "object",
  "properties": {
    "status": {
      "$ref": "RoleResultStatus.json"
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "findings": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "RoleFinding.json"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["status", "summary"],
  "additionalProperties": true
}
