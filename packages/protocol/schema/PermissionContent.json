{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PermissionContent",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "toolCallId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "PermissionOption.json"
      }
    },
    "chosenOptionId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["requestId", "title", "options"],
  "additionalProperties": true
}
