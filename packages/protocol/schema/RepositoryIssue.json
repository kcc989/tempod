{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryIssue",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "state": {
      "$ref": "IssueState.json"
    },
    "authorId": {
      "type": "string"
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "closedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "RepositoryLabel.json"
      }
    },
    "commentCount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": [
    "id",
    "projectId",
    "number",
    "title",
    "body",
    "state",
    "authorId",
    "createdAt",
    "updatedAt",
    "closedAt",
    "url",
    "labels",
    "commentCount"
  ],
  "additionalProperties": true
}
