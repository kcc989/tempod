{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkProjectIn",
  "type": "object",
  "properties": {
    "installationId": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "repoId": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "organizationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "visibility": {
      "anyOf": [
        {
          "$ref": "ProjectVisibility.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["installationId", "repoId"],
  "additionalProperties": true
}
