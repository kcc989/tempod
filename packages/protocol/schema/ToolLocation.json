{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolLocation",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "line": {
      "anyOf": [
        {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": ["Infinity", "-Infinity", "NaN"]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["path"],
  "additionalProperties": true
}
