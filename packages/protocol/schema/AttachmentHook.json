{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AttachmentHook",
  "type": "object",
  "properties": {
    "event": {
      "$ref": "HookEvent.json"
    },
    "when": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["event"],
  "additionalProperties": true
}
