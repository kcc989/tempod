{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LifecycleTurnEndedPayload",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "cancelled", "failed", "interrupted"]
    },
    "stopReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "TurnUsage.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["status", "stopReason"],
  "additionalProperties": true
}
