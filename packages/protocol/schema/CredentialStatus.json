{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialStatus",
  "type": "object",
  "properties": {
    "claude": {
      "$ref": "CredentialState.json"
    },
    "codex": {
      "type": "object",
      "properties": {
        "set": {
          "type": "boolean"
        },
        "updatedAt": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": ["Infinity", "-Infinity", "NaN"]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lastRefresh": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": ["Infinity", "-Infinity", "NaN"]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["set", "updatedAt", "lastRefresh"],
      "additionalProperties": true
    },
    "openrouter": {
      "$ref": "CredentialState.json"
    },
    "anthropic": {
      "$ref": "CredentialState.json"
    },
    "openai": {
      "$ref": "CredentialState.json"
    }
  },
  "required": ["claude", "codex", "openrouter", "anthropic", "openai"],
  "additionalProperties": true
}
