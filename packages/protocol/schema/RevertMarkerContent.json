{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RevertMarkerContent",
  "type": "object",
  "properties": {
    "checkpointId": {
      "type": "string"
    },
    "toTurnSeq": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["checkpointId", "toTurnSeq"],
  "additionalProperties": true
}
