{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScriptRun",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "ScriptKind.json"
    },
    "scriptId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "type": "string"
    },
    "status": {
      "$ref": "ScriptRunStatus.json"
    },
    "exitCode": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "endedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["id", "kind", "scriptId", "command", "status", "exitCode", "signal", "startedAt", "endedAt"],
  "additionalProperties": true
}
