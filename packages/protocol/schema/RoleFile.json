{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoleFile",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "agent": {
      "$ref": "RoleAgent.json"
    },
    "model": {
      "type": "string"
    },
    "access": {
      "$ref": "RoleAccess.json"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requestable": {
      "type": "boolean"
    },
    "on": {
      "type": "array",
      "items": {
        "$ref": "RoleTrigger.json"
      }
    },
    "limits": {
      "$ref": "RoleLimits.json"
    }
  },
  "required": ["description", "agent", "model", "access", "inputs", "requestable", "on", "limits"],
  "additionalProperties": true
}
