{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoleFinding",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "line": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "allOf": [
            {
              "minimum": 0
            },
            {
              "minimum": 1
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean"
    }
  },
  "required": ["path", "text", "blocking"],
  "additionalProperties": true
}
