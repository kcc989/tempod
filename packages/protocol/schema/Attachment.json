{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attachment",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "mime": {
      "type": "string"
    },
    "size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["id", "name", "mime", "size"],
  "additionalProperties": true
}
