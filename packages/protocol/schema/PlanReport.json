{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanReport",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "blocked"]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "PlanStep.json"
      }
    },
    "verify": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": ["status", "summary", "steps"],
  "additionalProperties": true
}
