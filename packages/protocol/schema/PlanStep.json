  "properties": {
    "text": {
      "type": "string",
      "maxLength": 1000
    },
    "files": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["text"],
  "additionalProperties": true
}
