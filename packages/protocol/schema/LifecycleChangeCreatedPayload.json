{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LifecycleChangeCreatedPayload",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string",
      "enum": ["prompt", "request", "event"]
    },
    "handle": {
      "anyOf": [
        {
          "$ref": "AgentHandle.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 65536
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["origin"],
  "additionalProperties": true
}
