{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CiPipeline",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "CiJobSpec.json"
      }
    },
    "required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "egressAllowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updatedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "projectId",
    "revision",
    "source",
    "enabled",
    "jobs",
    "required",
    "egressAllowlist",
    "updatedAt"
  ],
  "additionalProperties": true
}
