{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectProfile",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "updatedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["projectId", "revision", "source", "updatedAt"],
  "additionalProperties": true
}
