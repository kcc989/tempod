{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewComment",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "lineStart": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lineEnd": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "side": {
      "anyOf": [
        {
          "$ref": "ReviewSide.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "string"
    },
    "status": {
      "$ref": "ReviewStatus.json"
    },
    "sentTurnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["id", "path", "lineStart", "lineEnd", "side", "body", "status", "sentTurnId", "createdAt"],
  "additionalProperties": true
}
