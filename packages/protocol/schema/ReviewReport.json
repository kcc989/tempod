{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewReport",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "blocked"]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "RunFinding.json"
      }
    }
  },
  "required": ["status", "summary"],
  "additionalProperties": true
}
