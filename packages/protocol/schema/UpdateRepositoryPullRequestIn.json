{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpdateRepositoryPullRequestIn",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["open", "closed"]
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["projectId", "number"],
  "additionalProperties": true
}
