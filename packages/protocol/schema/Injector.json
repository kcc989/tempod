{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Injector",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "code": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    }
  },
  "required": ["name", "hosts", "code", "sha256"],
  "additionalProperties": true
}
