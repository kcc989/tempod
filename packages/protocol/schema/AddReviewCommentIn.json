{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddReviewCommentIn",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "lineStart": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lineEnd": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "side": {
      "anyOf": [
        {
          "$ref": "ReviewSide.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["workspaceId", "path", "body"],
  "additionalProperties": true
}
