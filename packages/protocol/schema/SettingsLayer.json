{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SettingsLayer",
  "type": "object",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "default": {
              "anyOf": [
                {
                  "$ref": "AgentId.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "scripts": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "setup": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "archive": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run_mode": {
              "anyOf": [
                {
                  "$ref": "RunMode.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "auto_run_after_setup": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "run": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string"
                      },
                      "cwd": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "default": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": ["command"],
                    "additionalProperties": true
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "instance": {
              "anyOf": [
                {
                  "$ref": "Instance.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sleep_after_idle_minutes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "allOf": [
                    {
                      "minimum": 5,
                      "maximum": 240
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "egress_policy": {
              "anyOf": [
                {
                  "$ref": "EgressPolicy.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "egress_allowlist": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_variables": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "git": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "branch_prefix": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "delete_branch_on_archive": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "archive_on_merge": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "prompts": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "general": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
