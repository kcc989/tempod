{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckpointInfo",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnSeq": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "$ref": "CheckpointReason.json"
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["id", "turnId", "turnSeq", "reason", "createdAt"],
  "additionalProperties": true
}
