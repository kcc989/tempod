{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeployRollout",
  "type": "object",
  "properties": {
    "phase": {
      "$ref": "DeployRolloutPhase.json"
    },
    "canaryUntil": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rolledBackAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "workers": {
      "type": "array",
      "items": {
        "$ref": "DeployRolloutWorker.json"
      }
    }
  },
  "required": ["phase", "canaryUntil", "rolledBackAt", "workers"],
  "additionalProperties": true
}
