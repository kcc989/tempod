{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryPullRequest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "headBranch": {
      "type": "string"
    },
    "baseBranch": {
      "type": "string"
    },
    "state": {
      "$ref": "PrState.json"
    },
    "url": {
      "type": "string"
    },
    "headSha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseSha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mergeSha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "mergedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "projectId",
    "number",
    "title",
    "body",
    "headBranch",
    "baseBranch",
    "state",
    "url",
    "headSha",
    "baseSha",
    "mergeSha",
    "createdAt",
    "updatedAt",
    "mergedAt"
  ],
  "additionalProperties": true
}
