{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpServer",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "transport": {
      "$ref": "McpTransport.json"
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "array",
      "items": {
        "$ref": "McpEnvVar.json"
      }
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "headers": {
      "type": "array",
      "items": {
        "$ref": "McpHeader.json"
      }
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "enabled",
    "transport",
    "command",
    "args",
    "env",
    "url",
    "headers",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": true
}
