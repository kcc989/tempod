{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorBody",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "ErrorCode.json"
    },
    "message": {
      "type": "string"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["code", "message"],
  "additionalProperties": true
}
