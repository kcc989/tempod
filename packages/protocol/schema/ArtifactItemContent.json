{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtifactItemContent",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "mime": {
      "type": "string"
    },
    "artifactKind": {
      "$ref": "ArtifactKind.json"
    },
    "size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["artifactId", "version", "title", "name", "path", "mime", "artifactKind", "size"],
  "additionalProperties": true
}
