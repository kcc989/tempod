{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectMember",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "username": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "role": {
      "$ref": "ProjectRole.json"
    }
  },
  "required": ["userId", "username", "name", "image", "role"],
  "additionalProperties": true
}
