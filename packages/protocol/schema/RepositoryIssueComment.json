{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryIssueComment",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "issueId": {
      "type": "string"
    },
    "authorId": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["id", "issueId", "authorId", "body", "createdAt", "updatedAt"],
  "additionalProperties": true
}
