{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeployTarget",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "auto": {
      "type": "boolean"
    },
    "agent": {
      "type": "boolean"
    },
    "rollout": {
      "$ref": "DeployRolloutKind.json"
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "smoke": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["key", "stage", "branch", "auto", "agent", "rollout", "workers", "smoke"],
  "additionalProperties": true
}
