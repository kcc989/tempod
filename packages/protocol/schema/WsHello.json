{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WsHello",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["hello"]
    },
    "v": {
      "type": "number",
      "enum": [1]
    },
    "workspace": {
      "$ref": "WorkspaceDetail.json"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "Session.json"
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "Turn.json"
      }
    },
    "itemsRev": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["type", "v", "workspace", "sessions", "turns", "itemsRev"],
  "additionalProperties": true
}
