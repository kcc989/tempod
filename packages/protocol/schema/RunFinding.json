{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunFinding",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "allOf": [
        {
          "minimum": 0
        },
        {
          "minimum": 1
        }
      ]
    },
    "text": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean"
    }
  },
  "required": ["path", "text", "blocking"],
  "additionalProperties": true
}
