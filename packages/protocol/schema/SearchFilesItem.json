{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchFilesItem",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "line": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "text": {
      "type": "string"
    }
  },
  "required": ["path", "line", "text"],
  "additionalProperties": true
}
