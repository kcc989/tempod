{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangesSummary",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "ChangedFile.json"
      }
    },
    "additions": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "deletions": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["files", "additions", "deletions"],
  "additionalProperties": true
}
