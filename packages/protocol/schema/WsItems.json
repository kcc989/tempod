{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WsItems",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["items"]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "Item.json"
      }
    },
    "itemsRev": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "done": {
      "type": "boolean"
    }
  },
  "required": ["type", "items", "itemsRev", "done"],
  "additionalProperties": true
}
