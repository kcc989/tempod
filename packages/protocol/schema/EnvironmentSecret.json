    "name": {
      "type": "string"
    },
    "hosts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "set": {
      "type": "boolean"
    }
  },
  "required": ["name", "hosts", "set"],
  "additionalProperties": true
}
