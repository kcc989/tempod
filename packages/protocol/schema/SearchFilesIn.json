{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchFilesIn",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "regex": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["workspaceId", "query"],
  "additionalProperties": true
}
