{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateWorkspaceIn",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "source": {
      "$ref": "NewSource.json"
    },
    "agent": {
      "anyOf": [
        {
          "$ref": "AgentId.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "customAgentId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["text"],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["projectId", "source"],
  "additionalProperties": true
}
