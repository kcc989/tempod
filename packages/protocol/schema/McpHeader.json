{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpHeader",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "secret": {
      "type": "boolean"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "set": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["name", "secret", "value"],
  "additionalProperties": true
}
