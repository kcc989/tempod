{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckRun",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "conclusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "type": "string"
    }
  },
  "required": ["name", "status", "conclusion", "url"],
  "additionalProperties": true
}
