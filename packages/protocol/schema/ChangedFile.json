{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangedFile",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "oldPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string"
    },
    "additions": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "deletions": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["path", "status", "additions", "deletions"],
  "additionalProperties": true
}
