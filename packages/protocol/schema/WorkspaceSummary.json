{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkspaceSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "baseBranch": {
      "type": "string"
    },
    "state": {
      "$ref": "WorkspaceState.json"
    },
    "attention": {
      "$ref": "Attention.json"
    },
    "defaultAgent": {
      "$ref": "AgentId.json"
    },
    "prNumber": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "prState": {
      "anyOf": [
        {
          "$ref": "PrState.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "checksState": {
      "anyOf": [
        {
          "$ref": "ChecksState.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "lastActivityAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "archivedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rev": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": [
    "id",
    "projectId",
    "slug",
    "title",
    "branch",
    "baseBranch",
    "state",
    "attention",
    "defaultAgent",
    "prNumber",
    "prState",
    "checksState",
    "pinned",
    "lastActivityAt",
    "createdAt",
    "archivedAt",
    "rev"
  ],
  "additionalProperties": true
}
