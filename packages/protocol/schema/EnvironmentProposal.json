{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvironmentProposal",
  "type": "object",
  "properties": {
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "egressPolicy": {
      "anyOf": [
        {
          "$ref": "EgressPolicy.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowlistAdd": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "secrets": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "SecretBinding.json"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "injectors": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "InjectorInput.json"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["note"],
  "additionalProperties": true
}
