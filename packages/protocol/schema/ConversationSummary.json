{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversationSummary",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["conversationId", "projectId", "title", "branch", "updatedAt"],
  "additionalProperties": true
}
