{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Session",
  "type": "object",
  "properties": {
    "roleRunId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "agent": {
      "$ref": "AgentId.json"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "$ref": "SessionStatus.json"
    },
    "modeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "modes": {
      "type": "array",
      "items": {
        "$ref": "SessionMode.json"
      }
    },
    "configOptions": {
      "type": "array",
      "items": {
        "$ref": "ConfigOption.json"
      }
    },
    "config": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "AvailableCommand.json"
      }
    },
    "usage": {
      "$ref": "Usage.json"
    },
    "sortOrder": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "steering": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "customAgent": {
      "anyOf": [
        {
          "$ref": "SessionCustomAgent.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "profileIssues": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "ProfileIssue.json"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "agent",
    "title",
    "status",
    "modeId",
    "modes",
    "configOptions",
    "config",
    "commands",
    "usage",
    "sortOrder"
  ],
  "additionalProperties": true
}
