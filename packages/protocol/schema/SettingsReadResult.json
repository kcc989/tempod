{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SettingsReadResult",
  "type": "object",
  "properties": {
    "effective": {
      "$ref": "Settings.json"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "SettingsSource.json"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["effective", "warnings", "errors"],
  "additionalProperties": true
}
