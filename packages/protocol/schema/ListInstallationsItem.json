{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ListInstallationsItem",
  "type": "object",
  "properties": {
    "installationId": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "accountLogin": {
      "type": "string"
    },
    "accountType": {
      "type": "string",
      "enum": ["User", "Organization"]
    }
  },
  "required": ["installationId", "accountLogin", "accountType"],
  "additionalProperties": true
}
