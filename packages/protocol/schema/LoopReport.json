{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoopReport",
  "type": "object",
  "properties": {
    "from": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "to": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "intent_shown",
              "intent_corrections",
              "preview_proof",
              "proof_to_merge",
              "ci",
              "merge_to_live",
              "rollback",
              "error_seen",
              "error_fixed"
            ]
          },
          "n": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "median": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": ["Infinity", "-Infinity", "NaN"]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "p90": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": ["Infinity", "-Infinity", "NaN"]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "targetMedian": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "targetP90": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "met": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["step", "n", "median", "p90", "targetMedian", "targetP90", "met"],
        "additionalProperties": true
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["from", "to", "steps", "violations"],
  "additionalProperties": true
}
