{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChecklistItem",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["open", "resolved"]
    },
    "sourceItemId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolvedBy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["id", "text", "status", "sourceItemId", "resolvedBy", "createdAt"],
  "additionalProperties": true
}
