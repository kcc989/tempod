{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CloudflareHoldContent",
  "type": "object",
  "properties": {
    "holdId": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "resource": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "allowed", "refused", "used"]
    }
  },
  "required": ["holdId", "method", "path", "resource", "reasons", "status"],
  "additionalProperties": true
}
