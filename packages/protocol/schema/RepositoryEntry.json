{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryEntry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "hash": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["tree", "blob", "symlink", "gitlink", "exec"]
    }
  },
  "required": ["name", "path", "hash", "type"],
  "additionalProperties": true
}
