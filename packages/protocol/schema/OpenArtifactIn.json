{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenArtifactIn",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    }
  },
  "required": ["workspaceId", "artifactId", "version"],
  "additionalProperties": true
}
