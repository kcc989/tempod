{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntentContent",
  "type": "object",
  "properties": {
    "intentId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["awaiting", "proposed", "confirmed", "corrected"]
    },
    "goal": {
      "type": "string"
    },
    "approach": {
      "type": "string"
    },
    "notDoing": {
      "type": "string"
    },
    "decidedBy": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["owner", "judge"]
        },
        {
          "type": "null"
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enforced": {
      "type": "boolean"
    }
  },
  "required": ["intentId", "status", "goal", "approach", "notDoing", "decidedBy", "reasons", "enforced"],
  "additionalProperties": true
}
