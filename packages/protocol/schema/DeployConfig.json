{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeployConfig",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "source": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "DeployTool.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "root": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "DeployPermission.json"
      }
    },
    "timeoutMinutes": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "egressAllowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "DeployTarget.json"
      }
    },
    "autoFix": {
      "type": "boolean"
    },
    "updatedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "projectId",
    "revision",
    "source",
    "enabled",
    "tool",
    "root",
    "permissions",
    "timeoutMinutes",
    "egressAllowlist",
    "targets",
    "autoFix",
    "updatedAt"
  ],
  "additionalProperties": true
}
