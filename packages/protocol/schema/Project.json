{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "installationId": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "repoId": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "owner": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "defaultBranch": {
      "type": "string"
    },
    "settings": {
      "$ref": "SettingsLayer.json"
    },
    "sortOrder": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "environmentId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["id", "installationId", "repoId", "owner", "name", "defaultBranch", "settings", "sortOrder"],
  "additionalProperties": true
}
