{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigOption",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "currentValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "options": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "ConfigSelectOption.json"
              },
              {
                "$ref": "ConfigSelectGroup.json"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["id", "name", "type", "currentValue"],
  "additionalProperties": true
}
