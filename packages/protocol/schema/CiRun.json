{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CiRun",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "branch": {
      "type": "string"
    },
    "sha": {
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "trigger": {
      "type": "string",
      "enum": ["push", "manual", "rerun"]
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed"]
    },
    "conclusion": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["success", "failure", "cancelled"]
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "startedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "projectId",
    "number",
    "branch",
    "sha",
    "revision",
    "attempt",
    "trigger",
    "status",
    "conclusion",
    "createdAt",
    "startedAt",
    "completedAt",
    "url"
  ],
  "additionalProperties": true
}
