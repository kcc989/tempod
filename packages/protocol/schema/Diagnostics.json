{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnostics",
  "type": "object",
  "properties": {
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "OpKind.json"
          },
          "status": {
            "$ref": "OpStatus.json"
          },
          "step": {
            "type": "string"
          },
          "attempt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "errorDetail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "timings": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": ["Infinity", "-Infinity", "NaN"]
                }
              ]
            }
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "step",
          "attempt",
          "errorCode",
          "errorDetail",
          "timings",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": true
      }
    },
    "container": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "WorkspaceState.json"
        },
        "running": {
          "type": "boolean"
        },
        "instance": {
          "type": "string"
        },
        "imageRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sizeBytes": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": ["Infinity", "-Infinity", "NaN"]
                  }
                ]
              },
              "imageRef": {
                "type": "string"
              },
              "createdAt": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": ["Infinity", "-Infinity", "NaN"]
                  }
                ]
              },
              "lastRestoredAt": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": ["Infinity", "-Infinity", "NaN"]
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unusable": {
                "type": "boolean"
              }
            },
            "required": ["id", "name", "sizeBytes", "imageRef", "createdAt", "lastRestoredAt", "unusable"],
            "additionalProperties": true
          }
        },
        "tempodVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "incarnation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["state", "running", "instance", "imageRef", "snapshots", "tempodVersion", "incarnation"],
      "additionalProperties": true
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "level": {
            "type": "string"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["ts", "level", "msg"],
        "additionalProperties": true
      }
    },
    "egress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "method": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          },
          "rule": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": ["Infinity", "-Infinity", "NaN"]
              }
            ]
          }
        },
        "required": ["ts", "method", "host", "path", "status", "ms", "rule"],
        "additionalProperties": true
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "$ref": "AgentId.json"
          },
          "acpSessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "capabilities": {
            "$ref": "Capabilities.json"
          },
          "live": {
            "type": "boolean"
          }
        },
        "required": ["id", "agent", "acpSessionId", "capabilities", "live"],
        "additionalProperties": true
      }
    }
  },
  "required": ["ops", "container", "logs", "egress", "sessions"],
  "additionalProperties": true
}
