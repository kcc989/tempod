{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoleTrigger",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": ["role.run.completed"]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "RoleName.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "RoleResultStatus.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["event"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": ["role.run.failed"]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "RoleName.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["event"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": ["agent.turn.ended"]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["completed", "cancelled", "failed", "interrupted"]
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["user", "role"]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["event"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": ["tempo.branch.pushed"]
        }
      },
      "required": ["event"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": ["tempo.check.passed"]
        }
      },
      "required": ["event"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": ["tempo.check.failed"]
        }
      },
      "required": ["event"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": ["tempo.change.created"]
        }
      },
      "required": ["event"],
      "additionalProperties": true
    }
  ]
}
