{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpStdioServer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["stdio"]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["name", "type", "command", "args", "env"],
  "additionalProperties": true
}
