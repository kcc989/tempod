{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Turn",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "seq": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "status": {
      "$ref": "TurnStatus.json"
    },
    "queuePos": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "steeringPending": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt": {
      "$ref": "TurnPrompt.json"
    },
    "stopReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpointId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reverted": {
      "type": "boolean"
    },
    "queuedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "startedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "endedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "totalTokens": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": ["Infinity", "-Infinity", "NaN"]
                }
              ]
            },
            "inputTokens": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": ["Infinity", "-Infinity", "NaN"]
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": ["Infinity", "-Infinity", "NaN"]
                }
              ]
            },
            "thoughtTokens": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "enum": ["Infinity", "-Infinity", "NaN"]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "cachedReadTokens": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "enum": ["Infinity", "-Infinity", "NaN"]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "cachedWriteTokens": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "enum": ["Infinity", "-Infinity", "NaN"]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["totalTokens", "inputTokens", "outputTokens"],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "sessionId",
    "seq",
    "status",
    "queuePos",
    "prompt",
    "stopReason",
    "errorCode",
    "checkpointId",
    "reverted",
    "queuedAt",
    "startedAt",
    "endedAt"
  ],
  "additionalProperties": true
}
