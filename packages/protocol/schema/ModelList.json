{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelList",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "$ref": "ModelPick.json"
      }
    },
    "updatedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "enum": ["Infinity", "-Infinity", "NaN"]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["models", "updatedAt"],
  "additionalProperties": true
}
